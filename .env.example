# Trading System Environment Configuration
# Copy to .env and fill in your actual values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Authentication
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Email Notifications
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=alerts@trading-system.com
EMAIL_RECIPIENTS=your-email@gmail.com

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#trading-alerts

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR/WEBHOOK

# Custom Webhook
CUSTOM_WEBHOOK_URL=https://your-api.com/webhooks/trading

# MCP Agent Configuration
AGENT_MONITORING_INTERVAL=300  # 5 minutes
AGENT_MAX_CONCURRENT_ANALYSES=5
AGENT_BUY_THRESHOLD=0.70
AGENT_CONFIDENCE_THRESHOLD=0.65

# Watchlist Configuration
DEFAULT_WATCHLIST_TICKERS=AAPL,MSFT,NVDA,TSLA,GOOGL
WATCHLIST_AUTO_UPDATE=true
WATCHLIST_CHECK_FREQUENCY=300  # seconds

# Celery Configuration (Phase 3C)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=postgresql://postgres:postgres@localhost:5432/trading_db
CELERY_TIMEZONE=UTC

# Data Retention
ANALYSIS_HISTORY_RETENTION_DAYS=90
NOTIFICATION_LOG_RETENTION_DAYS=30
PERFORMANCE_DATA_RETENTION_DAYS=365

# Feature Flags
ENABLE_AGENT=true
ENABLE_NOTIFICATIONS=true
ENABLE_EMAIL=true
ENABLE_SLACK=true
ENABLE_DISCORD=false
ENABLE_WEBHOOKS=false
ENABLE_CELERY_MONITORING=false

# Performance
REQUEST_TIMEOUT=30
ANALYSIS_TIMEOUT=5
NOTIFICATION_TIMEOUT=10

# Security
CORS_ORIGINS=*
ALLOWED_DOMAINS=localhost,127.0.0.1,example.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # seconds

# Monitoring
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_PORT=9090
ENABLE_HEALTH_CHECK=true

# Logging
LOG_FORMAT=json
LOG_FILE=/app/logs/trading-system.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Deployment
ENVIRONMENT=development  # development, staging, production
DEPLOY_VERSION=3.1.0
